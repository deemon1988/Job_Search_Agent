# Telegram Bot Token (получить в @BotFather в Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# Список Telegram ID пользователей с доступом (через запятую). Оставьте пустым, чтобы разрешить всем.
ALLOWED_USER_IDS=

# ==========================================
# ВЫБОР ПРОВАЙДЕРА LLM: openai или gemini
# ==========================================
LLM_PROVIDER=openai

# ==========================================
# 1. Настройки OpenAI Chat GPT API
# ==========================================
# Ваш API ключ OpenAI (начинается с sk-...)
OPENAI_API_KEY=sk-your-openai-api-key-here
# Модель: gpt-6-luna (по умолчанию), gpt-4o-mini, gpt-4o, o3-mini и др.
OPENAI_MODEL=gpt-6-luna
# Уровень рассуждений reasoning.effort: 'low', 'medium', 'high' (рекомендуется 'medium')
OPENAI_REASONING_EFFORT=medium
# Базовый URL (по умолчанию https://api.openai.com/v1, можно указать OpenRouter, ProxyAPI, VseGPT и др.)
OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================
# 2. Настройки Google Gemini API (альтернатива)
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash

# ==========================================
# База данных и CRM
# ==========================================
DATABASE_PATH=data/job_agent.db

# ==========================================
# Интеграция с Google Sheets
# ==========================================
# 1. Поместите файл credentials.json от сервисного аккаунта в корень проекта
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
# 2. Укажите название вашей Google Таблицы (или ее ID из адресной строки браузера)
GOOGLE_SHEET_NAME_OR_ID=Job_Search_CRM
